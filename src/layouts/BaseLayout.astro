---
import "../styles/global.css";
import { SITE_NAME, LOCALE } from "../lib/site";
import { canonical } from "../lib/schema";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: unknown | unknown[];
  noindex?: boolean;
  ogType?: "website" | "article";
  publishedTime?: Date;
}

const {
  title,
  description,
  path,
  jsonLd,
  noindex = false,
  ogType = "website",
  publishedTime,
} = Astro.props;
const url = canonical(path);
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex,follow" />
    ) : (
      <meta name="robots" content="index,follow,max-image-preview:large" />
    )}
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#06251e" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    {ogType === "article" && publishedTime ? (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    ) : null}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" hreflang="es-MX" href={url} />
    <meta name="generator" content={Astro.generator} />
    {jsonLdItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-STXSHL7YRH" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-STXSHL7YRH');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header path={path} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
