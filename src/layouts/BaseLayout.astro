---
import "../styles/global.css";
import { SITE_NAME, LOCALE, assetUrl } from "../lib/site";
import { canonical } from "../lib/schema";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: unknown | unknown[];
  noindex?: boolean;
  ogType?: "website" | "article";
  publishedTime?: Date;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
}

const {
  title,
  description,
  path,
  jsonLd,
  noindex = false,
  ogType = "website",
  publishedTime,
  image,
  imageAlt,
  imageWidth,
  imageHeight,
} = Astro.props;
const url = canonical(path);
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const imageUrl = image ? assetUrl(image) : undefined;
const adsenseClient = "ca-pub-9573612374074710";
const gaId = "G-STXSHL7YRH";
---

<!doctype html>
<html lang={LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex,follow" />
    ) : (
      <meta name="robots" content="index,follow,max-image-preview:large" />
    )}
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="describedby" href="/llms.txt" title="llms.txt" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta name="theme-color" content="#06251e" />
    <meta name="google-adsense-account" content={adsenseClient} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    {imageUrl ? (
      <>
        <meta property="og:image" content={imageUrl} />
        {imageAlt ? <meta property="og:image:alt" content={imageAlt} /> : null}
        {imageWidth ? <meta property="og:image:width" content={String(imageWidth)} /> : null}
        {imageHeight ? <meta property="og:image:height" content={String(imageHeight)} /> : null}
      </>
    ) : null}
    {ogType === "article" && publishedTime ? (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    ) : null}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl ? <meta name="twitter:image" content={imageUrl} /> : null}
    <link rel="alternate" hreflang="es-MX" href={url} />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://googleads.g.doubleclick.net" />
    <link rel="dns-prefetch" href="https://tpc.googlesyndication.com" />
    <link rel="dns-prefetch" href="https://ep1.adtrafficquality.google" />
    <meta name="generator" content={Astro.generator} />
    {jsonLdItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <!-- Google AdSense (official head snippet; ads start after first paint) -->
    <script is:inline>
      window.adsbygoogle = window.adsbygoogle || [];
      window.adsbygoogle.pauseAdRequests = 1;
    </script>
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
      crossorigin="anonymous"
      data-overlays="bottom"
      is:inline></script>
    <!-- Google tag (gtag.js) — property stays in markup; script loads after idle -->
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.__GA_MEASUREMENT_ID = gaId;
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header path={path} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (function () {
        var adsReleased = false;
        var gaLoaded = false;

        function releaseAds() {
          if (adsReleased) return;
          adsReleased = true;
          try {
            (window.adsbygoogle = window.adsbygoogle || []).pauseAdRequests = 0;
          } catch (err) {
            /* ignore */
          }
        }

        function loadAnalytics() {
          if (gaLoaded) return;
          gaLoaded = true;
          var id = window.__GA_MEASUREMENT_ID || "G-STXSHL7YRH";
          var script = document.createElement("script");
          script.src = "https://www.googletagmanager.com/gtag/js?id=" + id;
          script.async = true;
          document.head.appendChild(script);
          gtag("js", new Date());
          gtag("config", id, { transport_type: "beacon" });
        }

        function afterFirstPaint(fn) {
          var run = function () {
            if ("requestIdleCallback" in window) {
              requestIdleCallback(fn, { timeout: 2500 });
            } else {
              setTimeout(fn, 1);
            }
          };
          if (document.readyState === "complete") run();
          else window.addEventListener("load", run, { once: true });
        }

        afterFirstPaint(releaseAds);
        afterFirstPaint(loadAnalytics);
      })();
    </script>
  </body>
</html>
