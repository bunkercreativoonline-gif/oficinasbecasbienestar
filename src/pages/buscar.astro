---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Disclaimer from "../components/Disclaimer.astro";
import { getEstadoHubs, getSearchIndex, getStats } from "../lib/sedes";
import { buscarDescription, buscarTitle } from "../lib/schema";

const title = buscarTitle();
const description = buscarDescription();
const index = getSearchIndex();
const estados = getEstadoHubs();
const stats = getStats();
const initialQ = Astro.url.searchParams.get("q") ?? "";
const initialEstado = Astro.url.searchParams.get("estado") ?? "";
const initialTipo = Astro.url.searchParams.get("tipo") ?? "";
---

<BaseLayout title={title} description={description} path="/buscar/">
  <section class="section">
    <div class="wrap">
      <Breadcrumbs items={[{ label: "Inicio", href: "/" }, { label: "Buscar" }]} />
      <h1 class="page-title">Buscar sedes de atención</h1>
      <p class="lede">
        Filtra las {stats.sedes} oficinas de Becas Bienestar Benito Juárez por palabra clave,
        estado o tipo (CABB, SARE u ORE). La búsqueda se hace en tu navegador.
      </p>
      <form class="panel filter-bar" id="buscador" role="search">
        <div>
          <label for="q">Palabra clave</label>
          <input id="q" name="q" type="search" value={initialQ} placeholder="Municipio, colonia o nombre" />
        </div>
        <div>
          <label for="estado">Estado</label>
          <select id="estado" name="estado">
            <option value="">Todos</option>
            {
              estados.map((estado) => (
                <option value={estado.slug} selected={estado.slug === initialEstado}>
                  {estado.display}
                </option>
              ))
            }
          </select>
        </div>
        <div>
          <label for="tipo">Tipo</label>
          <select id="tipo" name="tipo">
            <option value="">Todos</option>
            <option value="CABB" selected={initialTipo === "CABB"}>CABB</option>
            <option value="SARE" selected={initialTipo === "SARE"}>SARE</option>
            <option value="ORE" selected={initialTipo === "ORE"}>ORE</option>
          </select>
        </div>
        <div class="actions" style="margin: 0;">
          <button class="btn btn-primary" type="submit">Filtrar</button>
        </div>
      </form>
      <p class="results-meta" id="conteo" aria-live="polite"></p>
      <div class="grid-cards" id="resultados"></div>
      <p class="empty" id="vacio" hidden>
        No hay sedes con esos filtros. Prueba con el municipio o el estado.
      </p>
      <div style="margin-top: 1.5rem;">
        <Disclaimer />
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ index }}>
  const form = document.getElementById("buscador");
  const results = document.getElementById("resultados");
  const countEl = document.getElementById("conteo");
  const empty = document.getElementById("vacio");
  const qInput = document.getElementById("q");
  const estadoInput = document.getElementById("estado");
  const tipoInput = document.getElementById("tipo");

  function norm(value) {
    return String(value || "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase();
  }

  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, (char) => {
      const map = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" };
      return map[char] || char;
    });
  }

  function badgeClass(tipo) {
    if (tipo === "SARE") return "badge badge-sare";
    if (tipo === "ORE") return "badge badge-ore";
    return "badge";
  }

  function render(list) {
    if (!results || !countEl || !empty) return;
    countEl.textContent = `${list.length} ${list.length === 1 ? "sede encontrada" : "sedes encontradas"}`;
    empty.hidden = list.length > 0;
    results.innerHTML = list
      .slice(0, 120)
      .map((sede) => {
        return `<a class="card" href="${escapeHtml(sede.path)}">
          <span class="${badgeClass(sede.tipo)}">${escapeHtml(sede.tipo)}</span>
          <h2 style="margin:0.45rem 0 0.35rem;font-size:1.02rem;line-height:1.3;">${escapeHtml(sede.nombre)}</h2>
          <p class="meta" style="margin:0;">${escapeHtml(sede.municipio)}, ${escapeHtml(sede.estado)}<br>${escapeHtml(sede.direccion)}<br>C.P. ${escapeHtml(sede.cp)}</p>
        </a>`;
      })
      .join("");
    if (list.length > 120) {
      results.insertAdjacentHTML(
        "beforeend",
        `<p class="meta">Mostrando 120 de ${list.length}. Añade un municipio o estado para acotar.</p>`,
      );
    }
  }

  function apply() {
    const q = norm(qInput && "value" in qInput ? qInput.value : "");
    const estado = estadoInput && "value" in estadoInput ? estadoInput.value : "";
    const tipo = tipoInput && "value" in tipoInput ? tipoInput.value : "";
    const filtered = index.filter((sede) => {
      if (estado && sede.estadoSlug !== estado) return false;
      if (tipo && sede.tipo !== tipo) return false;
      if (!q) return true;
      const haystack = norm(
        [sede.nombre, sede.municipio, sede.estado, sede.direccion, sede.cp, sede.tipo].join(" "),
      );
      return haystack.includes(q);
    });
    render(filtered);
    const params = new URLSearchParams();
    if (qInput && qInput.value.trim()) params.set("q", qInput.value.trim());
    if (estado) params.set("estado", estado);
    if (tipo) params.set("tipo", tipo);
    const next = params.toString();
    const url = next ? `/buscar/?${next}` : "/buscar/";
    history.replaceState(null, "", url);
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    apply();
  });
  qInput?.addEventListener("input", apply);
  estadoInput?.addEventListener("change", apply);
  tipoInput?.addEventListener("change", apply);
  apply();
</script>
