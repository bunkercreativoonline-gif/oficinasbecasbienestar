---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchForm from "../components/SearchForm.astro";
import EstadoGrid from "../components/EstadoGrid.astro";
import Disclaimer from "../components/Disclaimer.astro";
import { getEstadoHubs } from "../lib/sedes";
import { notFoundDescription, notFoundH1, notFoundTitle } from "../lib/schema";

const estados = getEstadoHubs();
---

<BaseLayout
  title={notFoundTitle()}
  description={notFoundDescription()}
  path="/404/"
  noindex
>
  <section class="section">
    <div class="wrap">
      <h1 class="page-title">{notFoundH1()}</h1>
      <p class="lede">
        El enlace puede estar mal escrito o la oficina ya no está en el directorio de
        Oficinas de Becas para el Bienestar Benito Juárez. Busca por municipio o entra
        al listado de tu estado.
      </p>
      <div class="panel" style="margin-bottom: 1.5rem;">
        <SearchForm />
      </div>
      <h2>Ir a un estado</h2>
      <EstadoGrid estados={estados} />
      <div style="margin-top: 1.5rem;">
        <Disclaimer />
      </div>
    </div>
  </section>
</BaseLayout>
