---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Disclaimer from "../../../components/Disclaimer.astro";
import SedeCard from "../../../components/SedeCard.astro";
import MapEmbed from "../../../components/MapEmbed.astro";
import {
  getMunicipioHubs,
  getSedesByMunicipio,
} from "../../../lib/sedes";
import { plural } from "../../../lib/format";
import {
  breadcrumbJsonLd,
  itemListJsonLd,
  municipioDescription,
  municipioH1,
  municipioListName,
  municipioTitle,
} from "../../../lib/schema";

export function getStaticPaths() {
  return getMunicipioHubs().map((hub) => ({
    params: { estado: hub.estadoSlug, municipio: hub.slug },
  }));
}

const { estado, municipio } = Astro.params;
if (!estado || !municipio) throw new Error("Faltan parámetros");

const hubs = getMunicipioHubs(estado);
const hub = hubs.find((item) => item.slug === municipio);
if (!hub) throw new Error(`Municipio no encontrado: ${estado}/${municipio}`);

const sedes = getSedesByMunicipio(estado, municipio);
const title = municipioTitle(hub.display);
const description = municipioDescription({
  municipio: hub.display,
  estado: hub.estadoDisplay,
});
const heading = municipioH1(hub.display, hub.estadoDisplay);
const crumbs = [
  { name: "Inicio", path: "/" },
  { name: hub.estadoDisplay, path: `/estado/${hub.estadoSlug}/` },
  { name: hub.display, path: hub.path },
];
const mapSede = sedes.find((sede) => sede.lat !== null && sede.lng !== null) ?? sedes[0];
---

<BaseLayout
  title={title}
  description={description}
  path={hub.path}
  jsonLd={[
    breadcrumbJsonLd(crumbs),
    itemListJsonLd(
      municipioListName(hub.display, hub.estadoDisplay),
      hub.path,
      sedes.map((sede) => ({ name: sede.nombreDisplay, path: sede.path })),
    ),
  ]}
>
  <section class="section">
    <div class="wrap">
      <Breadcrumbs
        items={[
          { label: "Inicio", href: "/" },
          { label: hub.estadoDisplay, href: `/estado/${hub.estadoSlug}/` },
          { label: hub.display },
        ]}
      />
      <h1 class="page-title">{heading}</h1>
      <p class="lede">
        {hub.count === 1
          ? `Hay 1 oficina o sede de atención de Becas para el Bienestar Benito Juárez registrada en ${hub.display}, ${hub.estadoDisplay}.`
          : `Hay ${hub.count} oficinas o sedes de atención de Becas para el Bienestar Benito Juárez en ${hub.display}, ${hub.estadoDisplay}: ${hub.cabb} CABB, ${hub.sare} SARE y ${hub.ore} ORE.`}
        Consulta dirección y contacto de cada sede antes de acudir.
      </p>
      <div class="sede-hero">
        <ul class="grid-cards" style="grid-template-columns: 1fr;">
          {sedes.map((sede) => (
            <li>
              <SedeCard sede={sede} headingLevel="h2" />
            </li>
          ))}
        </ul>
        <MapEmbed
          lat={mapSede.lat}
          lng={mapSede.lng}
          nombre={`Sedes en ${hub.display}`}
          direccion={mapSede.direccion}
        />
      </div>
      <p class="meta" style="margin-top: 1.2rem;">
        Ver también: <a href={`/estado/${hub.estadoSlug}/`}>todas las oficinas de {hub.estadoDisplay}</a>
        · {hub.count} {plural(hub.count, "resultado", "resultados")} en este municipio.
      </p>
      <div style="margin-top: 1.5rem;">
        <Disclaimer />
      </div>
    </div>
  </section>
</BaseLayout>
