---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Disclaimer from "../../../components/Disclaimer.astro";
import SedeCard from "../../../components/SedeCard.astro";
import SearchForm from "../../../components/SearchForm.astro";
import {
  getEstadoHub,
  getEstadoHubs,
  getMunicipioHubs,
  getSedesByEstado,
} from "../../../lib/sedes";
import { plural } from "../../../lib/format";
import {
  breadcrumbJsonLd,
  estadoDescription,
  estadoH1,
  estadoListName,
  estadoTitle,
  itemListJsonLd,
} from "../../../lib/schema";

export function getStaticPaths() {
  return getEstadoHubs().map((hub) => ({
    params: { estado: hub.slug },
  }));
}

const { estado } = Astro.params;
if (!estado) throw new Error("Falta el estado");

const hub = getEstadoHub(estado);
if (!hub) throw new Error(`Estado no encontrado: ${estado}`);

const sedes = getSedesByEstado(estado);
const municipios = getMunicipioHubs(estado);
const title = estadoTitle(hub.display, hub.count);
const description = estadoDescription(hub);
const heading = estadoH1(hub.display);
const crumbs = [
  { name: "Inicio", path: "/" },
  { name: hub.display, path: hub.path },
];
---

<BaseLayout
  title={title}
  description={description}
  path={hub.path}
  jsonLd={[
    breadcrumbJsonLd(crumbs),
    itemListJsonLd(
      estadoListName(hub.display),
      hub.path,
      sedes.map((sede) => ({ name: sede.nombreDisplay, path: sede.path })),
    ),
  ]}
>
  <section class="section">
    <div class="wrap">
      <Breadcrumbs items={[{ label: "Inicio", href: "/" }, { label: hub.display }]} />
      <h1 class="page-title">{heading}</h1>
      <p class="lede">
        Hay {hub.count} {plural(hub.count, "oficina", "oficinas")} o sedes de atención de
        Becas para el Bienestar Benito Juárez en {hub.display}{hub.oficial !== hub.display
          ? ` (nombre oficial: ${hub.oficial})`
          : ""}: {hub.cabb} CABB, {hub.sare} SARE y {hub.ore} ORE, repartidas en {hub.municipios}{" "}
        {plural(hub.municipios, "municipio", "municipios")}.
      </p>
      <div class="panel" style="margin-bottom: 1.4rem;">
        <SearchForm compact q={hub.display} />
      </div>
      <h2>Municipios con oficina</h2>
      <p class="intro">Selecciona tu municipio para consultar la dirección de cada sede.</p>
      <div class="grid-estados">
        {
          municipios.map((muni) => (
            <a class="estado-card" href={muni.path}>
              <b>{muni.display}</b>
              <span class="muted">
                {muni.count} {plural(muni.count, "sede", "sedes")}
              </span>
            </a>
          ))
        }
      </div>
      <h2 style="margin-top: 2rem;">Todas las oficinas de Becas para el Bienestar Benito Juárez en {hub.display}</h2>
      <div class="grid-cards">
        {sedes.map((sede) => <SedeCard sede={sede} />)}
      </div>
      <div style="margin-top: 1.5rem;">
        <Disclaimer />
      </div>
    </div>
  </section>
</BaseLayout>
