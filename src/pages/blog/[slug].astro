---
import { readFileSync } from "node:fs";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Disclaimer from "../../components/Disclaimer.astro";
import BlogHero from "../../components/BlogHero.astro";
import BecasBienestarLink from "../../components/BecasBienestarLink.astro";
import {
  BLOG_OG_HEIGHT,
  BLOG_OG_WIDTH,
  blogIsoDate,
  blogPath,
  formatBlogDate,
  getPublishedPosts,
  type BlogPost,
} from "../../lib/blog";
import {
  articleJsonLd,
  blogPostDescription,
  blogPostH1,
  blogPostTitle,
  breadcrumbJsonLd,
} from "../../lib/schema";
import { hasBecasBienestarOutboundLink } from "../../lib/becasBienestar";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

function postHasBecasBienestarLink(post: BlogPost): boolean {
  const chunks = [post.body ?? "", post.rendered?.html ?? ""];
  if (post.filePath) {
    try {
      chunks.push(readFileSync(post.filePath, "utf8"));
    } catch {
      /* source may be unavailable during some renders */
    }
  }
  return chunks.some((chunk) => hasBecasBienestarOutboundLink(chunk));
}

const { post } = Astro.props;
const { Content } = await render(post);
const path = blogPath(post.id);
const title = blogPostTitle(post.data.title);
const description = blogPostDescription(post.data.description);
const heading = blogPostH1(post.data.title);
const alreadyLinkedBecasBienestar = postHasBecasBienestarLink(post);
const crumbs = [
  { name: "Inicio", path: "/" },
  { name: "Noticias", path: "/blog/" },
  { name: post.data.title, path },
];
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="article"
  publishedTime={post.data.pubDate}
  image={post.data.image}
  imageAlt={post.data.imageAlt ?? post.data.title}
  imageWidth={BLOG_OG_WIDTH}
  imageHeight={BLOG_OG_HEIGHT}
  jsonLd={[
    breadcrumbJsonLd(crumbs),
    articleJsonLd({
      title: post.data.title,
      description,
      path,
      pubDate: post.data.pubDate,
      updatedDate: post.data.updatedDate,
      image: post.data.image,
      imageWidth: BLOG_OG_WIDTH,
      imageHeight: BLOG_OG_HEIGHT,
    }),
  ]}
>
  <article class="section">
    <div class="wrap blog-article">
      <Breadcrumbs
        items={[
          { label: "Inicio", href: "/" },
          { label: "Noticias", href: "/blog/" },
          { label: post.data.title },
        ]}
      />
      <p>
        <span class="badge">Guía</span>
      </p>
      <BlogHero
        src={post.data.image}
        alt={post.data.imageAlt ?? post.data.title}
        width={BLOG_OG_WIDTH}
        height={BLOG_OG_HEIGHT}
      />
      <h1 class="page-title">{heading}</h1>
      {
        alreadyLinkedBecasBienestar ? null : (
          <p class="lede">
            Guía para pedir orientación sobre <BecasBienestarLink /> y decidir cuándo acudir a una
            sede de atención.
          </p>
        )
      }
      <p class="blog-byline meta">
        Publicado el{" "}
        <time datetime={blogIsoDate(post.data.pubDate)}>{formatBlogDate(post.data.pubDate)}</time>
        {
          post.data.updatedDate && (
            <>
              {" "}
              · Actualizado el{" "}
              <time datetime={blogIsoDate(post.data.updatedDate)}>
                {formatBlogDate(post.data.updatedDate)}
              </time>
            </>
          )
        }
      </p>
      <div class="blog-prose">
        <Content />
      </div>
      <div style="margin-top: 1.5rem;">
        <Disclaimer linkBecasBienestar={!alreadyLinkedBecasBienestar} />
      </div>
    </div>
  </article>
</BaseLayout>
