---
import type { Sede } from "../lib/sedes";

interface Props {
  sede: Pick<
    Sede,
    | "path"
    | "nombreDisplay"
    | "tipo"
    | "tipoShort"
    | "municipioDisplay"
    | "estadoDisplay"
    | "direccionLimpia"
    | "telefonos"
  >;
  headingLevel?: "h2" | "h3";
}

const { sede, headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const badgeClass =
  sede.tipo === "SARE" ? "badge badge-sare" : sede.tipo === "ORE" ? "badge badge-ore" : "badge";
---

<a class="card" href={sede.path}>
  <span class={badgeClass}>{sede.tipoShort}</span>
  <Heading style="margin: 0.45rem 0 0.35rem; font-size: 1.02rem; line-height: 1.3; font-family: inherit;">
    {sede.nombreDisplay}
  </Heading>
  <p class="meta" style="margin: 0;">
    {sede.municipioDisplay}, {sede.estadoDisplay}
    <br />
    {sede.direccionLimpia.calleNumero}
    <br />
    {sede.direccionLimpia.coloniaLinea}
    {sede.telefonos[0] ? ` · Tel. ${sede.telefonos[0]}` : ""}
  </p>
</a>
