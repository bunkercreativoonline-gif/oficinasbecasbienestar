---
import SearchForm from "./SearchForm.astro";
import { PRIMARY_PHRASE, SITE_URL } from "../lib/site";

interface Props {
  heading?: string;
}

const { heading = "Acude a una oficina en tu ciudad" } = Astro.props;
---

<aside class="panel blog-cta" aria-label="Localizar una oficina en tu ciudad">
  <p><span class="badge">Directorio</span></p>
  <h2>{heading}</h2>
  <p>
    Si tu caso necesita papeles, una incidencia o una explicación más clara, suele
    convenir ir a una sede de atención. Este sitio es un directorio independiente de
    {PRIMARY_PHRASE}: las direcciones salen del catálogo público de sedes y debes
    confirmarlas antes de visitar.
  </p>
  <SearchForm
    idPrefix="guia"
    submitLabel="Buscar oficina"
    toolname="buscar_oficina_guia"
  />
  <div class="actions">
    <a class="btn btn-primary" href={SITE_URL + "/"}>Ver directorio de oficinas</a>
    <a class="btn btn-ghost" href="/#estados">Ver por estado</a>
  </div>
</aside>
