---
import { PRIMARY_PHRASE } from "../lib/site";

interface Props {
  path: string;
}

const { path } = Astro.props;

const links = [
  { href: "/", label: "Inicio", match: (p: string) => p === "/" },
  { href: "/#estados", label: "Estados", match: (p: string) => p.startsWith("/estado/") },
  { href: "/tipo/sare/", label: "SARE", match: (p: string) => p === "/tipo/sare/" },
  { href: "/tipo/cabb/", label: "CABB", match: (p: string) => p === "/tipo/cabb/" },
  { href: "/tipo/ore/", label: "ORE", match: (p: string) => p === "/tipo/ore/" },
  { href: "/buscar/", label: "Buscar", match: (p: string) => p.startsWith("/buscar/") },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <svg class="brand-mark" viewBox="0 0 36 36" aria-hidden="true">
        <rect width="36" height="36" rx="9" fill="#146e5c"></rect>
        <path d="M18 7.5c-4 0-7.2 3.1-7.2 7 0 5.4 7.2 13 7.2 13s7.2-7.6 7.2-13c0-3.9-3.2-7-7.2-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z" fill="#f6f3ec"></path>
        <rect x="0" y="31" width="36" height="5" fill="#a57b12"></rect>
      </svg>
      <span class="brand-text">
        <strong>{PRIMARY_PHRASE}</strong>
        <span>Directorio de sedes de atención en México</span>
      </span>
    </a>
    <nav class="nav" aria-label="Principal">
      {
        links.map((link) => (
          <a href={link.href} aria-current={link.match(path) ? "page" : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
