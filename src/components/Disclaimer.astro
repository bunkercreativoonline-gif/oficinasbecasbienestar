---
import { OFFICIAL_BUSCADOR, SOURCE_UPDATED } from "../lib/site";
import BecasBienestarLink from "./BecasBienestarLink.astro";

interface Props {
  /**
   * When false, skip the outbound Becas Bienestar sentence. Use this on pages
   * that already linked https://becasmexico.org/becas-bienestar/ in the body.
   */
  linkBecasBienestar?: boolean;
}

const { linkBecasBienestar = true } = Astro.props;
---

<aside class="disclaimer" role="note" aria-label="Aviso">
  <strong>Aviso.</strong> Los datos de este directorio se obtuvieron del
  <a href={OFFICIAL_BUSCADOR} rel="noopener noreferrer">buscador oficial de sedes de atención</a>
  de la Coordinación Nacional de Becas para el Bienestar Benito Juárez ({SOURCE_UPDATED}).
  Horarios, teléfonos y vigencia pueden cambiar: confírmalos en el sitio oficial antes de acudir.
  Este sitio no gestiona citas ni es un portal de gobierno.
  {
    linkBecasBienestar ? (
      <>
        {" "}
        Para más contexto sobre <BecasBienestarLink />, consulta fuentes independientes
        y verifica siempre en el sitio oficial.
      </>
    ) : null
  }
</aside>
