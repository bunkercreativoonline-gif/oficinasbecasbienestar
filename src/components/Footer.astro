---
import {
  OFFICIAL_BUSCADOR,
  OFFICIAL_PROGRAMA,
  PRIMARY_PHRASE,
  SITE_DOMAIN,
  SOURCE_UPDATED,
} from "../lib/site";
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <section>
      <p class="footer-heading">{PRIMARY_PHRASE}</p>
      <p>
        Directorio independiente de oficinas y sedes de atención de Becas para el
        Bienestar Benito Juárez. No es un sitio oficial de gobierno.
      </p>
    </section>
    <nav aria-label="Directorio">
      <p class="footer-heading">Directorio</p>
      <ul class="footer-links">
        <li><a href="/">Inicio</a></li>
        <li><a href="/buscar/">Buscar oficina</a></li>
        <li><a href="/blog/">Noticias</a></li>
        <li>
          <a href="/tipo/cabb/">CABB</a> ·
          <a href="/tipo/sare/">SARE</a> ·
          <a href="/tipo/ore/">ORE</a>
        </li>
      </ul>
    </nav>
    <nav aria-label="Fuentes oficiales">
      <p class="footer-heading">Fuentes oficiales</p>
      <ul class="footer-links">
        <li>
          <a href={OFFICIAL_BUSCADOR} rel="noopener noreferrer">Buscador de sedes</a>
        </li>
        <li>
          <a href={OFFICIAL_PROGRAMA} rel="noopener noreferrer">Programa en gob.mx</a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="wrap footer-copy">
    Datos tomados del buscador oficial ({SOURCE_UPDATED}). Verifica la información antes de acudir.
    Dominio: {SITE_DOMAIN}.
  </div>
</footer>
